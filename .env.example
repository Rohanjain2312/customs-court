# Copy to .env. Never commit .env.

# Required for live runs. Tests, eval-smoke and the replay demo need no key.
ANTHROPIC_API_KEY=
# Optional: only for the small provider comparison.
OPENAI_API_KEY=
# Optional: only for free Hugging Face hosting.
HF_TOKEN=

# Model tiers. Never Opus-class or Fable-class (config refuses them).
REASONER_MODEL=claude-sonnet-5
ADVOCATE_MODEL=claude-haiku-4-5
JUDGE_MODEL=claude-haiku-4-5
OPENAI_MODEL=gpt-5-mini

# Spend caps in USD. Calls fail closed when a cap would be exceeded.
BUDGET_USD_TOTAL=40
BUDGET_USD_PER_RUN=8
BUDGET_USD_PER_DAY=20
DEMO_SESSION_CAP_USD=2

# Serve only from the on-disk response cache; never call an API.
OFFLINE=false
# Hide every ruling that belongs to an evaluation set from all tools.
REDACT_EVAL=false
# Local embedding model on or off (BM25 only when off).
USE_VECTORS=true

# Deploy scripts refuse to run unless this is exactly "yes". Leave it unset.
# I_ACCEPT_CLOUD_COSTS=
